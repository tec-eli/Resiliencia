<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tec-eli</groupId>
        <artifactId>resiliencia</artifactId>
        <version>1.0.0-beta.1</version>
    </parent>

    <artifactId>resiliencia-stress</artifactId>
    <packaging>jar</packaging>

    <scm>
        <connection>scm:git:https://github.com/tec-eli/resiliencia.git</connection>
        <developerConnection>scm:git:https://github.com/tec-eli/resiliencia.git</developerConnection>
        <url>https://github.com/tec-eli/resiliencia</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- jcstress harness classes are annotation-processor-generated, not hand-written unit tests. -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.tec-eli</groupId>
            <artifactId>resiliencia-patterns</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jcstress</groupId>
            <artifactId>jcstress-core</artifactId>
            <version>0.16</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jcstress</groupId>
                            <artifactId>jcstress-core</artifactId>
                            <version>0.16</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                Packages this module as an executable uber-jar so jcstress's own harness
                (org.openjdk.jcstress.Main) can be launched directly with `java -jar`.
                Runs on `mvn package`, not on `mvn compile`, and only in this module: not
                published (maven.deploy.skip=true above), developer/release-gated only.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                Without this, shade replaces the main artifact jar in place: on a
                                second `package` run (no `mvn clean` in between), that already-shaded
                                jar gets treated as an input to shade again, colliding with the very
                                dependencies (e.g. JNA, pulled in transitively by jcstress-core)
                                already merged into it. Attaching the shaded jar as its own
                                `-shaded` classified artifact instead keeps the main jar untouched.
                            -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jcstress.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
